View(versiones_planificacion)
planificados_grupo <- planificados %>%
group_by(Fecha) %>%
summarise(total = n())
View(planificados_grupo)
planificados_grupo <- planificados %>%
group_by(Fecha) %>%
summarise(total = sum(Activos))
View(planificados_grupo)
