library(xml2)
library(purrr)
library(dplyr)
# 1. URL de GetCapabilities del WFS de GeoServer
url_capabilities <- "https://montevideo.gub.uy/app/geoserver/gol_publico/ows?service=WFS&version=1.0.0&request=GetCapabilities"
# 2. Leer el XML
xml_raw <- read_xml(url_capabilities)
# 3. Extraer los nodos de FeatureType (cada capa disponible)
# Manejo del namespace por defecto del XML
xml_ns_strip(xml_raw)
feature_types <- xml_find_all(xml_raw, "//FeatureType")
# 4. Construir un dataframe con los nombres técnicos y los títulos descriptivos
capas_disponibles <- tibble(
nombre_capa = xml_text(xml_find_first(feature_types, ".//Name")),
titulo      = xml_text(xml_find_first(feature_types, ".//Title")),
resumen     = xml_text(xml_find_first(feature_types, ".//Abstract"))
)
# 5. Ver el listado completo de capas
print(capas_disponibles, n = Inf)
system2(python_venv, args = "vistas/informe_operativa/informeOP_generar_pdf.py")
View(circuitos)
View(feature_types)
View(ver)
