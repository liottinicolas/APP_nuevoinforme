# --- Estado de IDE / sesion local (nunca debe versionarse) ---
.Rproj.user/
.Rhistory
*.Rhistory
.RData
.Ruserdata
*.RDataTmp
__pycache__/
*.pyc
*.lnk
# archivo vacio creado por error en la raiz
/python

# --- Secretos ---
# .Renviron tiene el GITHUB_PAT
.Renviron
.env
# Perfil de correo con credenciales en texto plano
*.mobileconfig

# --- Documentos / datos / salidas: no son codigo ---
# Los datos ya se sincronizan via OneDrive, no hace falta pushearlos a GitHub.
# Cada archivo de datos commiteado queda para siempre en el historial.
*.pdf
*.xlsx
*.xls
*.xlsm
*.ods
*.csv
*.parquet
*.rds
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.zip
*.docx
*.pptx
*.png
*.jpg
*.jpeg
*.gif

# HTML generados (informes y paginas guardadas para debug).
# Los templates SI se versionan: los leen armar_html.R / PorcentajeLlenado.R
*.html
!**/informe_template.html

# .txt: se ignoran por defecto (ej. COMPRAS/*.txt = contactos de terceros),
# salvo los que hacen falta para correr el proyecto
*.txt
!requirements.txt
!**/metadata.txt
!**/OFL.txt

# Copias de conflicto de OneDrive (ej. archivo-939868WN.png, mail-943653WN.py)
*-[0-9][0-9][0-9][0-9][0-9][0-9]WN.*
*-[0-9][0-9][0-9][0-9][0-9][0-9]WN

# --- Carpetas de salidas / descargas enteras ---
# Mapas y salidas auto-generadas
salidas/

# Reportes diarios generados
vistas/informediario/reportes/archivos/
vistas/informediario/reportes/Mapas/

# CSVs diarios descargados (input de cargaDeDatos.R).
# Los .py de archivos/ SI se versionan.
archivos/10393_ubicaciones/
archivos/GOL_reportes/

# Historicos RDS generados por UNA_POR_CIRCUITO
UNA_POR_CIRCUITO/rds/
UNA_POR_CIRCUITO/salidas/

# Pines de datos para la Shiny app: se publican en un repo de GitHub aparte
# (ver vistas/App_informe_llenado/limpieza_datos.R), no en este repo de codigo.
vistas/App_informe_llenado/data/
