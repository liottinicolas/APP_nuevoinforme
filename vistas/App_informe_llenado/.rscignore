# Los pines de datos se publican en un repo de GitHub aparte
# (APP_nuevoinforme-data, ver limpieza_datos.R). Si esta carpeta llegara a
# existir localmente al deployar, no debe subirse: si se empaqueta, queda
# congelada en el servidor y App.R deja de leer datos frescos vía board_url().
data/

# Versión anterior de la app (Leaflet), guardada solo como respaldo local
App_v2.R

# Scripts y documentos que se corren o leen en la PC, no en el servidor
limpieza_datos.R
perfilado_datos.R
actualizar_datos_app.R
documentacion_analisis.md
INSTRUCTIVO.md

# Paquete independiente para otra PC (lo arma armar_paquete.R)
paquete_independiente/
armar_paquete.R
